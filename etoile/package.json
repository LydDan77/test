{
  "name": "etoile",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "e2e": "next build && playwright test",
    "e2e:dev": "E2E_MODE=dev playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node -e \"require('node:fs').rmSync('.data',{recursive:true,force:true})\"",
    "data:airports": "node scripts/build-airports.mjs",
    "vercel-build": "drizzle-kit migrate && next build"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@vercel/functions": "^3.11.4",
    "aviation-names": "1.1.15",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.80.0",
    "maplibre-gl": "^6.19.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwindcss": "4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "airline-codes": "^1.1.7",
    "airport-data-js": "^4.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "geo-tz": "^8.1.11",
    "temporal-polyfill": "^1.0.8",
    "typescript": "^5",
    "vitest": "^5.1.2"
  }
}
