# Copy to .env.local for local overrides. Nothing here is required for local development:
# with no variables set the app uses an embedded Postgres (PGlite) in ./.data/pglite.
# Never commit real values.

# --- Database ---------------------------------------------------------------------------------
# Hosted Postgres (Vercel, Neon, Supabase, RDS, a local server). When set, PGlite is not used.
# Use the provider's pooled connection string here.
# DATABASE_URL=postgres://user:password@host:5432/etoile
# Direct (un-pooled) connection, used only by `drizzle-kit migrate`. Falls back to DATABASE_URL.
# DATABASE_URL_UNPOOLED=postgres://user:password@host:5432/etoile
# Connections per server instance (default 5).
# DATABASE_POOL_MAX=5
# 1 = apply migrations when the first query arrives, 0 = never. Default: on, except on Vercel,
# where `npm run vercel-build` migrates before building.
# DB_MIGRATE_ON_BOOT=1
# Where the embedded database lives when DATABASE_URL is unset (default ./.data/pglite).
# "memory://" gives a throwaway in-memory database.
# PGLITE_DATA_DIR=./.data/pglite
# 1 = leave the values in the error of a failed statement (they are removed by default, so that
# nothing a person typed and no secret reaches the log). Development only: ignored in production.
# DB_ERROR_DETAILS=1

# --- Sessions ---------------------------------------------------------------------------------
# 1 = in production mode, send the session cookie without Secure and the __Host- prefix.
# Only for `next start` on plain-http localhost (the end-to-end tests set it). Never on a host.
# Ignored on Vercel. A warning is logged at start when it is in effect.
# SESSION_COOKIE_INSECURE=1

# --- Rate limiting ------------------------------------------------------------------------------
# 1 = rateLimit() always allows (the end-to-end test server sets this: every test signs up from
# the same address). 0 = enforce limits even under `next dev`, where they are off by default.
# Ignored on Vercel, where limits are always enforced. A warning is logged when it is in
# effect in a production build.
# RATE_LIMIT_DISABLED=1
# How many reverse proxies of your own stand in front of the app (a load balancer, a CDN).
# REQUIRED off Vercel for per-address limits to exist: the visitor's address is then the entry
# that many places from the right of X-Forwarded-For. Unset or 0: no header is trusted, every
# visitor counts as "unknown", only the limits that need no address apply, and a warning is
# logged. On Vercel the platform's own header is used and this is ignored.
# TRUSTED_PROXY_COUNT=1
# New accounts the whole site may create in an hour, whoever asks (default 200).
# SIGN_UP_MAX_PER_HOUR=200

# --- Next.js ------------------------------------------------------------------------------------
# No telemetry.
NEXT_TELEMETRY_DISABLED=1
# Set to a stable value when more than one instance or build serves traffic (self-hosting).
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
